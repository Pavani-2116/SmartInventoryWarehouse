{
  "name": "smart-inventory-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:init": "node -e \"const fs=require('fs'); const db=require('./database/db'); db.exec(fs.readFileSync('./database/schema.sql','utf8')); console.log('SQLite schema initialized');\"",
    "db:seed": "node database/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
